<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml: MediaStore IDs are device-local and must not travel. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="inder.db" />
        <exclude domain="database" path="inder.db-shm" />
        <exclude domain="database" path="inder.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="inder.db" />
        <exclude domain="database" path="inder.db-shm" />
        <exclude domain="database" path="inder.db-wal" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<!--
    The decision history is keyed by MediaStore._ID, which is assigned per device
    and per volume. Restoring it onto another device would silently hide a random
    set of that device's photos, so the database is explicitly excluded from
    cloud backup.
-->
<full-backup-content>
    <exclude domain="database" path="inder.db" />
    <exclude domain="database" path="inder.db-shm" />
    <exclude domain="database" path="inder.db-wal" />
</full-backup-content>
